# ===============================================
# PUJA COLLECTION — ENVIRONMENT CONFIGURATION
# ===============================================

# 1. Database Connection URLs (Supabase PostgreSQL)
# For serverless / production: Supavisor Transaction Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# For migrations / Prisma CLI: Direct Connection (Port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 2. Admin Dashboard Security Credentials
ADMIN_EMAIL=admin@pujacollection.com.np
ADMIN_PASSWORD=Puja@Rangeli2026!
ADMIN_SECRET=puja-collection-rangeli-secret-key-2026

# 3. Meta WhatsApp Business Cloud API (Recommended & Free tier available)
# Create app at https://developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_CLOUD_API_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# 4. Alternatively: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 5. Store Contact Info
NEXT_PUBLIC_STORE_PHONE=+9779767784053
NEXT_PUBLIC_STORE_ADDRESS="Rangeli-7, Morang, Nepal"

# 6. Supabase Storage (for persistent cloud media uploads)
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"
